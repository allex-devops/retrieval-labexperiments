# copy to .env (git-ignored), uncomment ONE provider block and paste your key.
# Offline tests and the saved results need none of this; live runs and the API need an embedding endpoint,
# and the multilingual / query-rewriting experiments also need a chat model.

# --- OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-5.6-luna
# EMBED_MODEL=text-embedding-3-small

# --- Google Gemini, via its OpenAI-compatible endpoint ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-3.8-flash
# EMBED_MODEL=gemini-embedding-001

# Some embedding models were trained with task prefixes; set them if yours was (leave unset otherwise)
# EMBED_DOC_PREFIX="search_document: "
# EMBED_QUERY_PREFIX="search_query: "

# Only if your endpoint runs on this machine: how the Docker container reaches it
# CONTAINER_LLM_BASE_URL=http://host.docker.internal:8080/v1
